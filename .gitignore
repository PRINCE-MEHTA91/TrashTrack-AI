coverage/
**/coverage/
.cache/
**/.cache/
.turbo/
**/.turbo/
.parcel-cache/
**/.parcel-cache/
*.tsbuildinfo
**/*.tsbuildinfo

# 10. AI Agents, Assistants & Scratch Runtime
.agents/
**/.agents/
skills-lock.json
**/skills-lock.json
.gemini/
**/.gemini/
.system_generated/
**/.system_generated/

