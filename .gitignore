# ==============================================================================
# TrashTrack AI - Git Ignore Policy
# ==============================================================================

# 1. Security & Internal Docs
/docs/

# 2. Environment Variables & Secrets (NEVER publish to GitHub)
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*
**/.env.local
**/.env.*.local
!.env.example
!**/.env.example
!.env.production
!**/.env.production

# 3. Sensitive Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.id_rsa
*.id_rsa.pub
credentials.json
service-account*.json
token*.json

# 4. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.directory
$RECYCLE.BIN/

# 5. IDEs, Editors & Workspaces
.vscode/
**/.vscode/
.idea/
**/.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln

# 6. Dependencies & Package Managers
node_modules/
**/node_modules/
jspm_packages/
.pnp
.pnp.js

# 7. Production Builds, Bundles & Artifacts
dist/
**/dist/
build/
**/build/
dist-ssr/
**/dist-ssr/
out/
**/out/
.vite/
**/.vite/

# 8. Logs, Debug & Runtime Output
*.log
**/*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

