# TrashTrack ML Service — Environment Variables
# Copy this file to .env and fill in values before starting the service.
# NEVER commit the actual .env file to version control.

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Uvicorn server listens on (default: 8000)
PORT=8000

# ── Model ────────────────────────────────────────────────────────────────────
# Absolute or relative path to the trained .keras model file.
# Leave blank to use the default: ml-service/models/trashtrack_mobilenet_best.keras
MODEL_PATH=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this service.
# In production restrict this to your Node.js backend origin only.
ML_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173,http://localhost:5174

